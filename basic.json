[
  {
    "id": "basic-001",
    "topic": "basic",
    "subTopic": "Web Fundamentals",
    "difficulty": "Intermediate",
    "question": "Full mental model of how a web page load",
    "answer": [
      {
        "type": "h4",
        "text": "1️⃣ Big Picture: What happens when you open a website?"
      },
      {
        "type": "paragraph",
        "text": "When you type a website URL in the browser, multiple systems work together to locate the server and deliver the page."
      },
      {
        "type": "code",
        "language": "text",
        "code": "https://example.com"
      },
      {
        "type": "paragraph",
        "text": "Your browser does not magically know where the website is hosted. A chain of infrastructure components resolve and deliver the content."
      },
      {
        "type": "code",
        "language": "text",
        "code": "Browser → DNS → CDN → Dispatcher → Web Server → App → Database"
      },
      {
        "type": "h4",
        "text": "2️⃣ DNS (Domain Name System) – The Phonebook of the Internet"
      },
      {
        "type": "paragraph",
        "text": "DNS converts human-readable domain names into IP addresses."
      },
      {
        "type": "code",
        "language": "text",
        "code": "example.com → 93.184.216.34"
      },
      {
        "type": "bold",
        "text": "Steps"
      },
      {
        "type": "list",
        "style": "ordered",
        "items": ["Browser checks cache", "OS cache", "ISP DNS", "Root DNS → TLD → Authoritative DNS", "IP address returned"]
      },
      {
        "type": "info",
        "text": "DNS does not host content. It only resolves domain names to server locations (often a CDN)."
      },
      {
        "type": "h4",
        "text": "3️⃣ CDN (Content Delivery Network)"
      },
      {
        "type": "paragraph",
        "text": "A CDN is a global network of servers that cache website content and deliver it from the closest geographical location."
      },
      {
        "type": "bold",
        "text": "Popular CDNs"
      },
      {
        "type": "list",
        "style": "unordered",
        "items": ["Cloudflare", "Akamai", "AWS CloudFront"]
      },
      {
        "type": "bold",
        "text": "Why CDN is critical"
      },
      {
        "type": "code",
        "language": "text",
        "code": "Without CDN:\nUser in India → Server in US → Slow"
      },
      {
        "type": "code",
        "language": "text",
        "code": "With CDN:\nUser in India → Mumbai edge server → Fast"
      },
      {
        "type": "bold",
        "text": "What CDN caches"
      },
      {
        "type": "table",
        "columns": ["Cached by CDN", "Not Cached"],
        "data": [
          ["Images", "Personalized data"],
          ["CSS", "Logged-in dashboards"],
          ["JS", "Payment APIs"],
          ["HTML (sometimes)", "WebSockets"]
        ]
      },
      {
        "type": "h4",
        "text": "4️⃣ Publisher – Who publishes the website?"
      },
      {
        "type": "paragraph",
        "text": "The publisher is the entity responsible for building, deploying, and managing the website."
      },
      {
        "type": "bold",
        "text": "Examples"
      },
      {
        "type": "list",
        "style": "unordered",
        "items": ["News site → Media company", "E-commerce → Amazon or Flipkart", "Corporate website → Company itself"]
      },
      {
        "type": "bold",
        "text": "Publisher responsibilities"
      },
      {
        "type": "list",
        "style": "unordered",
        "items": ["Write application code", "Build assets", "Upload files to servers", "Configure CDN", "Define caching rules", "Deploy site to production"]
      },
      {
        "type": "h4",
        "text": "5️⃣ Dispatcher (Enterprise Layer)"
      },
      {
        "type": "paragraph",
        "text": "Dispatcher is a reverse proxy and caching layer placed between the CDN and the application servers."
      },
      {
        "type": "code",
        "language": "text",
        "code": "CDN ↔ Dispatcher ↔ Web Server ↔ Application"
      },
      {
        "type": "bold",
        "text": "Dispatcher responsibilities"
      },
      {
        "type": "list",
        "style": "ordered",
        "items": ["Cache HTML pages", "Filter allowed URLs", "Block malicious requests", "Route traffic to correct backend", "Protect application servers"]
      },
      {
        "type": "bold",
        "text": "Dispatcher vs CDN"
      },
      {
        "type": "table",
        "columns": ["CDN", "Dispatcher"],
        "data": [
          ["Global", "Inside infrastructure"],
          ["Edge-level caching", "Near origin"],
          ["Public network", "Private layer"],
          ["Faster delivery", "More controlled filtering"]
        ]
      },
      {
        "type": "h4",
        "text": "6️⃣ Web Server"
      },
      {
        "type": "paragraph",
        "text": "The web server receives HTTP requests and serves static assets or forwards dynamic requests to application servers."
      },
      {
        "type": "bold",
        "text": "Common Web Servers"
      },
      {
        "type": "list",
        "style": "unordered",
        "items": ["Apache", "Nginx"]
      },
      {
        "type": "code",
        "language": "http",
        "code": "GET /index.html"
      },
      {
        "type": "paragraph",
        "text": "Static files are served directly, while dynamic requests are forwarded to the application server."
      },
      {
        "type": "h4",
        "text": "7️⃣ Application Server"
      },
      {
        "type": "paragraph",
        "text": "Application servers run the business logic of the system."
      },
      {
        "type": "bold",
        "text": "Examples"
      },
      {
        "type": "list",
        "style": "unordered",
        "items": ["Node.js (Express, Nest)", "Java (Spring)", ".NET", "PHP (Laravel)"]
      },
      {
        "type": "bold",
        "text": "Responsibilities"
      },
      {
        "type": "list",
        "style": "unordered",
        "items": ["Authentication checks", "API calls", "Database queries", "Rendering HTML or JSON responses"]
      },
      {
        "type": "h4",
        "text": "8️⃣ Database & APIs"
      },
      {
        "type": "paragraph",
        "text": "Data is fetched from multiple sources."
      },
      {
        "type": "list",
        "style": "unordered",
        "items": ["SQL databases (MySQL, PostgreSQL)", "NoSQL databases (MongoDB)", "External APIs", "Cache layers such as Redis"]
      },
      {
        "type": "h4",
        "text": "9️⃣ Caching – The Secret Sauce"
      },
      {
        "type": "bold",
        "text": "Types of caching"
      },
      {
        "type": "list",
        "style": "ordered",
        "items": ["Browser Cache", "CDN Cache", "Dispatcher Cache", "Application Cache", "Database Cache"]
      },
      {
        "type": "code",
        "language": "http",
        "code": "Cache-Control: max-age=31536000"
      },
      {
        "type": "bold",
        "text": "Cache invalidation strategies"
      },
      {
        "type": "list",
        "style": "unordered",
        "items": ["Cache purge", "Versioned URLs", "TTL expiry", "Webhook based purge"]
      },
      {
        "type": "info",
        "text": "Caching is easy. Cache invalidation is one of the hardest problems in computer science."
      },
      {
        "type": "h4",
        "text": "🔟 How a Web Page Goes Live"
      },
      {
        "type": "list",
        "style": "ordered",
        "items": ["Developer writes code", "Code pushed to Git", "CI pipeline builds assets", "Files uploaded to server or CMS", "Dispatcher cache cleared", "CDN cache purged", "DNS points to CDN", "Users see the new page"]
      },
      {
        "type": "h4",
        "text": "1️⃣1️⃣ Real World Request Flow"
      },
      {
        "type": "code",
        "language": "text",
        "code": "User Browser\n↓\nDNS\n↓\nCDN (cached? yes → return)\n↓ no\nDispatcher (cached? yes → return)\n↓ no\nWeb Server\n↓\nApplication Server\n↓\nDatabase / APIs\n↑\nResponse cached on way back"
      },
      {
        "type": "h4",
        "text": "1️⃣2️⃣ Why This Matters"
      },
      {
        "type": "list",
        "style": "unordered",
        "items": ["Helps debug slow websites", "Useful in system design interviews", "Helps design scalable applications", "Improves architectural understanding"]
      }
    ]
  },
  {
    "id": "basic-002",
    "topic": "",
    "subTopic": "SEO",
    "difficulty": "Beginner",
    "question": "What is robots.txt?",
    "answer": [
      {
        "type": "bold",
        "content": [
          {
            "type": "text",
            "value": "Definition"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "badge",
            "value": "robots.txt"
          },
          {
            "type": "text",
            "value": " is a text file placed in the root of a website that tells search engine crawlers (bots) which pages they are allowed or not allowed to crawl."
          }
        ]
      },
      {
        "type": "bold",
        "content": [
          {
            "type": "text",
            "value": "Example URL:"
          }
        ]
      },
      {
        "type": "code",
        "language": "javascript",
        "code": "https://example.com/robots.txt"
      },
      {
        "type": "bold",
        "content": [
          {
            "type": "text",
            "value": "Why is it used?"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "value": "It is used to control how search engines like Google, Bing, etc., crawl your website."
          }
        ]
      },
      {
        "type": "bold",
        "content": [
          {
            "type": "text",
            "value": "Main Purpose"
          }
        ]
      },
      {
        "type": "list",
        "style": "ordered",
        "items": [
          [
            {
              "type": "text",
              "value": "Control Crawling"
            }
          ],
          {
            "type": "list",
            "style": "unordered",
            "items": [
              [
                {
                  "type": "text",
                  "value": "Prevent bots from accessing certain pages"
                }
              ]
            ]
          },
          [
            {
              "type": "text",
              "value": "Protect Sensitive Areas (Not secure, but helps)"
            }
          ],
          {
            "type": "list",
            "style": "unordered",
            "items": [
              [
                {
                  "type": "text",
                  "value": "Admin pages"
                }
              ],
              [
                {
                  "type": "text",
                  "value": "Internal APIs"
                }
              ],
              [
                {
                  "type": "text",
                  "value": "Temporary files"
                }
              ]
            ]
          },
          [
            {
              "type": "text",
              "value": "Optimize Crawl Budget"
            }
          ],
          {
            "type": "list",
            "style": "unordered",
            "items": [
              [
                {
                  "type": "text",
                  "value": "Search engines don’t waste time on irrelevant pages"
                }
              ]
            ]
          },
          [
            {
              "type": "text",
              "value": "Avoid Duplicate Content Issues"
            }
          ],
          {
            "type": "list",
            "style": "unordered",
            "items": [
              [
                {
                  "type": "text",
                  "value": "Block duplicate or unnecessary URLs"
                }
              ]
            ]
          }
        ]
      },
      {
        "type": "bold",
        "content": [
          {
            "type": "text",
            "value": "Basic Syntax"
          }
        ]
      },
      {
        "type": "code",
        "language": "javascript",
        "code": "User-agent: _\nDisallow: /admin/\nAllow: /public/"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "value": "Explanation"
          }
        ]
      },
      {
        "type": "table",
        "columns": ["Rule", "Meaning"],
        "data": [
          ["User-agent: *", "Applies to all bots"],
          ["Disallow: /admin/", "Block /admin folder"],
          ["Allow: /public/", "Allow /public"]
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "value": "Example"
          }
        ]
      },
      {
        "type": "code",
        "language": "javascript",
        "code": "User-agent: \\*\nDisallow: /private/\nDisallow: /temp/"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "value": "👉 Bots cannot crawl /private and /temp"
          }
        ]
      },
      {
        "type": "bold",
        "content": [
          {
            "type": "text",
            "value": "Important Points ⚠️"
          }
        ]
      },
      {
        "type": "list",
        "style": "unordered",
        "items": [
          [
            {
              "type": "text",
              "value": "❌ It does NOT secure data (just a guideline)"
            }
          ],
          [
            {
              "type": "text",
              "value": "❌ Bots can ignore it (malicious bots)"
            }
          ],
          [
            {
              "type": "text",
              "value": "✅ Only affects crawling, not indexing (in some cases)"
            }
          ]
        ]
      },
      {
        "type": "bold",
        "content": [
          {
            "type": "text",
            "value": "robots.txt vs Meta Robots"
          }
        ]
      },
      {
        "type": "table",
        "columns": ["Feature", "robots.txt", "Meta Robots"],
        "data": [
          ["Scope", "Whole site", "Specific page"],
          ["Location", "Root file", "HTML `<head>`"],
          ["Control", "Crawl", "Indexing"]
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "value": "Real Insight"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "value": "👉 Even if blocked in robots.txt, a page can still appear in search results if:"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "value": "Other sites link to it"
          }
        ]
      },
      {
        "type": "bold",
        "content": [
          {
            "type": "text",
            "value": "🔥 Interview Line"
          }
        ]
      },
      {
        "type": "info",
        "content": [
          {
            "type": "badge",
            "value": "robots.txt"
          },
          {
            "type": "text",
            "value": " is a file used to guide search engine crawlers on which parts of a website should or should not be crawled, helping optimize indexing and crawl efficiency."
          }
        ]
      },
      {
        "type": "bold",
        "content": [
          {
            "type": "text",
            "value": "🚀 Quick Summary"
          }
        ]
      },
      {
        "type": "list",
        "style": "unordered",
        "items": [
          [
            {
              "type": "text",
              "value": "File in root → /robots.txt"
            }
          ],
          [
            {
              "type": "text",
              "value": "Controls crawler access"
            }
          ],
          [
            {
              "type": "text",
              "value": "Improves SEO performance"
            }
          ],
          [
            {
              "type": "text",
              "value": "Not a security feature"
            }
          ]
        ]
      }
    ]
  },
  {
